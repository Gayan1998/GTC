# Copy to .env.production and adjust for your deployment.
#
# Domain root deployment (recommended) — leave everything commented out:
#   https://example.com/          -> React app
#   https://example.com/api/...   -> PHP API
#
# Sub-directory deployment — uncomment and edit:
# VITE_BASE_PATH=/gtc/
# VITE_API_BASE=/gtc/api
# VITE_MEDIA_BASE=/gtc
#
# Local development only: the Apache document root used by the Vite proxy.
# VITE_DEV_APACHE_BASE=http://localhost/GTC%20holdings/web
